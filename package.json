{
  "name": "vitest-evals-dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "Local dashboard for Vitest evals: run them, compare every run with a baseline, re-run single cases and see judge scores and costs.",
  "keywords": [
    "vitest",
    "vitest-evals",
    "evals",
    "llm",
    "ai",
    "dashboard",
    "baseline",
    "braintrust",
    "bun"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikuscs/vitest-evals-dashboard.git"
  },
  "type": "module",
  "bin": {
    "vitest-evals-dashboard": "./bin/vitest-evals-dashboard.ts"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./reporter": "./src/server/reporter.ts"
  },
  "files": [
    "bin",
    "src",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun bin/vitest-evals-dashboard.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vitest": ">=4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.555.0",
    "motion": "14.9.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "ts-pattern": "^5.9.2",
    "tw-animate-css": "1.4.0",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
